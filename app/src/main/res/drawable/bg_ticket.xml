<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main background with orange border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/ticket_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Left Notch (simulated with white circle) -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center_vertical|start"
        android:left="-12dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/ticket_border" />
        </shape>
    </item>

    <!-- Right Notch -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center_vertical|end"
        android:right="-12dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/ticket_border" />
        </shape>
    </item>
</layer-list>